prefer-no-csd //client side decorations off

blur {
    passes 4   // more passes = stronger blur (default: 3)
    offset 3.5     // sample distance per pass (default: 3.0)
    noise 0.01      // grain overlay (default: 0.02)
    saturation 1.6  // color saturation boost (default: 1.5)
}

// Global window appearance
window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
    opacity 1.0
    draw-border-with-background false
}

layout {
    gaps 6
    center-focused-column "never"
    background-color "transparent"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }

    focus-ring {
        width 1
    }

    insert-hint {
        off
    }

}

// layer rules
layer-rule {
    match namespace="^quickshell$"
    match namespace="^awww-daemon$"
    place-within-backdrop true
}
layer-rule {
    match namespace="^noctalia-wallpaper"
    opacity 0.0
}
layer-rule {
    match layer="top"
    match layer="overlay"

    background-effect {
        xray false
    }
}
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

overview {
    workspace-shadow {
        off
    }
}

animations {
    workspace-switch {
        spring damping-ratio=0.85 stiffness=850 epsilon=0.0001
    }
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
    }
    window-close {
        duration-ms 200
        curve "ease-out-expo"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=700 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.85 stiffness=700 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.8 stiffness=700 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 300
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.8 stiffness=900 epsilon=0.0001
    }
}

