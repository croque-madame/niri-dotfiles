layout {
    gaps 10
    center-focused-column "never"
    background-color "transparent"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.5
        proportion 1.0
    }

    focus-ring {
        width 2
    }

    insert-hint {
        off
    }

}
