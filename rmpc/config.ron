(
    password: None,
    cache_dir: Some("~/.cache/rmpc"),
    lyrics_dir: Some("~/Music"),
    enable_lyrics_index: true,
    theme: Some("matugen"),
    tabs: ([
        (
            name: "Artists",
            borders: ("NONE"),
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "80%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "75%",
                                    pane: Pane(AlbumArtists),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                                (
                                    size: "25%",
                                    pane: Pane(Cava),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                            ],
                        ),
                    ),
                    (size: "45", pane: Component("queue_sidebar")),
                ],
            ),
        ),
        (
            name: "Albums",
            borders: ("NONE"),
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "80%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "75%",
                                    pane: Pane(Albums),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                                (
                                    size: "25%",
                                    pane: Pane(Cava),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                            ],
                        ),
                    ),
                    (size: "45", pane: Component("queue_sidebar")),
                ],
            ),
        ),
        (
            name: "Playlists",
            borders: ("NONE"),
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "80%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "75%",
                                    pane: Pane(Playlists),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                                (
                                    size: "25%",
                                    pane: Pane(Cava),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                            ],
                        ),
                    ),
                    (size: "45", pane: Component("queue_sidebar")),
                ],
            ),
        ),
        (
            name: "Search",
            borders: ("NONE"),
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "80%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "75%",
                                    pane: Pane(Search),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                                (
                                    size: "25%",
                                    pane: Pane(Cava),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                            ],
                        ),
                    ),
                    (size: "45", pane: Component("queue_sidebar")),
                ],
            ),
        ),
        (
            name: "Files",
            borders: ("NONE"),
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "80%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "75%",
                                    pane: Pane(Directories),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                                (
                                    size: "25%",
                                    pane: Pane(Cava),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                            ],
                        ),
                    ),
                    (size: "45", pane: Component("queue_sidebar")),
                ],
            ),
        ),
        (
            name: "Lyrics",
            borders: ("NONE"),
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "80%",
                        pane: Split(
                            direction: Horizontal,
                            panes: [
                                (
                                    size: "65%",
                                    pane: Pane(Cava),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                ),
                                (
                                    size: "35%",
                                    pane: Pane(Lyrics),
                                    borders: ("ALL"),
                                    border_symbols: Rounded,
                                    border_title: [(kind: Text(" Lyrics "))],
                                    border_title_alignment: Right,
                                    border_title_position: Top,
                                ),
                            ],
                        ),
                    ),
                    (size: "45", pane: Component("queue_sidebar")),
                ],
            ),
        ),
    ]),
    keybinds: (
        global: {
            "1": SwitchToTab("Artists"),
            "2": SwitchToTab("Albums"),
            "3": SwitchToTab("Playlists"),
            "4": SwitchToTab("Search"),
            "5": SwitchToTab("Files"),
            "6": SwitchToTab("Lyrics"),
            "f": SeekForward,
            "b": SeekBack,
            "F": NextTrack,
            "B": PreviousTrack,
            "u": Update,
            "U": Rescan,
        },
        navigation: {
            "<C-j>": PaneDown,
            "<C-k>": PaneUp,
            "<C-h>": PaneLeft,
            "<C-l>": PaneRight,
            "ws": Save(kind: Modal(all: false, duplicates_strategy: Ask)),
            "wc": Save(kind: Modal(all: false, duplicates_strategy: Ask), current: true),
            "wa": Save(kind: Modal(all: true, duplicates_strategy: Ask)),
        },
    ),
    artists: (
        album_display_mode: NameOnly,
        album_sort_by: Date,
    ),
    cava: (
        framerate: 60,
        autosens: true,
        sensitivity: 100,
        lower_cutoff_freq: Some(50),
        higher_cutoff_freq: Some(10000),
        input: (
            method: Fifo,
            source: "/tmp/mpd.fifo",
            sample_rate: Some(44100),
            channels: Some(2),
            sample_bits: Some(16),
        ),
        smoothing: (
            noise_reduction: 40,
            monstercat: false,
            waves: false,
        ),
    ),
)
