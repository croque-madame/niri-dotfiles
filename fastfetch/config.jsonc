{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/art/*",
        "padding": {
            "top": 1,
            "right": 1
        },
    },
    "display": {
        "separator": "",
        "percent": {
            "type": 1
        },
        "bar": {
            "width": 8,
            "char": {
                "elapsed": "■",
                "total": "-"
            },
        },
        "key": {
            "width": 15
        }
    },
    "modules": [
        {
            "type": "break"
        },
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user    {#keys}│",
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "key": "│ {#33}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#34} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#35}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "type": "disk",
            "key": "│ {#36} age     {#keys}│",
            "format": "{years} years, {days-of-year} days",
            "folders": "/"
        },
        {
            "type": "packages",
            "key": "│ {#31}󰏖 pkgs    {#keys}│",
            "format": "{all}"
        },
        {
            "key": "│ {#32}󰇄 wm      {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#33}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#34} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#35}#!shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#36}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#31}󰢮 gpu     {#keys}│",
            "type": "gpu",
            "format": "{name}"
        },
        {
            "key": "│ {#32}󰋊 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#33}󰟶 memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "│ {#39} font    {#keys}│",
            "type": "terminalfont",
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
