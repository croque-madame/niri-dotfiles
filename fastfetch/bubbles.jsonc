{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/art/*",
        "padding": {
            "top": 1,
            "right": 1
        },
        "color": {
            "1": "36"
        }
    },
    "display": {
        "separator": "",
        "color": {
            "keys": "3"
        },
        "percent": {
            "type": 1
        }
    },
    "modules": [
        "break",
        // --- SECTION: SYSTEM ---
        {
            "type": "title",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m USR \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{user-name}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "os",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m󰣇 OS  \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{pretty-name}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "uptime",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m󰥔 UPT \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{formatted}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "packages",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m󰏖 PKG \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{all}\u001b[0m\u001b[38;5;235m"
        },
        "break",
        // --- SECTION: SOFTWARE ---
        {
            "type": "de",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m DE  \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{pretty-name} {version} ({protocol-name})\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "wm",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m WM  \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{pretty-name} {version} ({protocol-name})\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "shell",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m#!SHL \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{pretty-name} {version}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "terminal",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m TRM \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{pretty-name} {version}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "terminalfont",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m FNT \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{1}\u001b[0m\u001b[38;5;235m"
        },
        "break",
        // --- SECTION: HARDWARE ---
        {
            "type": "cpu",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m CPU \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{name}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "gpu",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m󰢮 GPU \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{name}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "memory",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m󰟶 RAM \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{used} / {total} {percentage}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "disk",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m󰋊 DSK \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{size-used} / {size-total} {size-percentage}\u001b[0m\u001b[38;5;235m"
        },
        {
            "type": "battery",
            "key": "\u001b[0m\u001b[34;48;0;235m\u001b[44;30m󰁹 BAT \u001b[0m\u001b[34;48;5;235m",
            "format": "\u001b[48;5;235m \u001b[38;2;200;200;200;3m{capacity}, [{status}]\u001b[0m\u001b[38;5;235m"
        }
    ]
}
